// Cloudflare Workers config: the built app (dist/) served as static files, no code of our own.
// Merging into main deploys it (Cloudflare Workers Builds); `pnpm run deploy` is the manual fallback.
// Live at https://good-dogs-only.byrecess.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogdex",
  "compatibility_date": "2026-09-01",
  // The old address stays up so phones can still open it to save a backup, and for preview links.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "good-dogs-only.byrecess.com", "custom_domain": true }
  ],
  // Branches other than main deploy as Previews (Workers Builds runs `wrangler preview`), which needs this block, even empty.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

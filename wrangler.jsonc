// Cloudflare Workers config: one Worker that checks the site password, then serves the built app from dist/.
// Deploy with: pnpm run deploy  (builds first; plain "pnpm deploy" is a different, built-in pnpm command). The password is a secret: pnpm exec wrangler secret put SITE_PASSWORD
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "good-dogs-only",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through the password check, photos included.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}

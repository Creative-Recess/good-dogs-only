// Cloudflare Workers config: the built app (dist/) served as static files, no code of our own.
// Deploy with: pnpm run deploy  (builds first; plain "pnpm deploy" is a different, built-in pnpm command)
// Live at https://dogdex.gooddogsonly.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogdex",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
